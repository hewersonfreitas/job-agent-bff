# Paths only; provision private files outside repositories. No defaults for secrets.
BFF_DIRECTORY=/absolute/path/job-agent-bff
BACKEND_DIRECTORY=/absolute/path/job-agent
BFF_ORIGIN=https://localhost:8443
BFF_OPERATOR_ID=operator-primary
BFF_PASSWORD_FILE=/absolute/private/operator.argon2
BFF_CA_FILE=/absolute/private/server-ca.crt
BFF_CERT_FILE=/absolute/private/bff.crt
BFF_KEY_FILE=/absolute/private/bff.key
# Compose bind-mounted secrets retain host ownership/mode. Set a compatible nonroot UID.
BFF_RUNTIME_USER=10001:10001
ATS_POLICY_DIRECTORY=/absolute/private/policy
ATS_TOKEN_FILE=/absolute/private/ats-token
ATS_SERVER_CERT_FILE=/absolute/private/ats-server.crt
ATS_SERVER_KEY_FILE=/absolute/private/ats-server.key
ATS_CLIENT_CA_FILE=/absolute/private/client-ca.crt
