        "name": "X-ATS-Operator",
        "type": "apiKey"
      },
      "ATSServiceBearer": {
        "description": "Server-held ATS bearer, in addition to mandatory transport mTLS and delegated operator",
        "scheme": "bearer",
        "type": "http"
      }
    }
